<Window x:Class="_7_Xlebobylochnoe.AuthorizationWindow.WindowAuthorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_7_Xlebobylochnoe.AuthorizationWindow"
        mc:Ignorable="d"
        Title="Окно авторизации"
        Height="850" Width="1000"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <TextBlock Text="Хлебобулочная"
                   TextAlignment="Center"
                   FontSize="60"
                   FontFamily="Comic Sans MS"
                   Background="BurlyWood"
                   Width="1000"
                   Height="90"
                   VerticalAlignment="Top"/>
        <!-- Панель авторизации -->
        <StackPanel x:Name="authPanel" Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="Авторизация"
                       TextAlignment="Center"
                       FontSize="60"
                       FontFamily="Comic Sans MS"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Логин"
                           FontSize="40"
                           FontFamily="Comic Sans"
                           Margin="0,40" 
                           TextAlignment="Right"
                           Width="150"/>
                <TextBox Width="400"
                         Height="40"
                         FontSize="20"
                         Margin="10,0,0,0"
                         x:Name="loginBox"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Пароль"
                           FontSize="40"
                           FontFamily="Comic Sans" 
                           TextAlignment="Right"
                           Width="150" TextWrapping="Wrap"/>
                <PasswordBox Width="400"
                             Height="40"
                             FontSize="20"
                             Margin="10,0,0,0"
                             x:Name="passwordBox"/>
            </StackPanel>

            <Button Content="ВОЙТИ"
                    FontSize="35"
                    Width="250"
                    Height="60"
                    FontFamily="Comic Sans MS"
                    Background="BurlyWood"
                    Margin="0,20" 
                    Click="AuthorizationButton_Click"/>
        </StackPanel>

        <!-- Панель CAPTCHA (изначально скрыта) -->
        <StackPanel x:Name="captchaPanel" Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">

            <TextBlock Text="Подтверждение"
                       FontSize="32"
                       FontFamily="Comic Sans MS"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"
                       Foreground="#333333"/>

            <TextBlock Text="Соберите картинку из 4 частей (2x2):"
                       FontSize="18"
                       FontFamily="Comic Sans"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"
                       Foreground="#555555"/>

            <!-- Сетка для сборки пазла (2x2) -->
            <Border BorderBrush="Black" 
                    BorderThickness="2"
                    Background="White"
                    CornerRadius="5"
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center">
                <Grid x:Name="puzzleTargetGrid" 
                      Width="240" 
                      Height="240">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>

                    <!-- Ячейки для drop -->
                    <Border x:Name="targetCell0" Grid.Row="0" Grid.Column="0" 
                            BorderBrush="Gray" BorderThickness="1" 
                            Background="#F0F0F0"
                            AllowDrop="True"
                            Drop="TargetCell_Drop"
                            DragOver="TargetCell_DragOver"/>
                    <Border x:Name="targetCell1" Grid.Row="0" Grid.Column="1" 
                            BorderBrush="Gray" BorderThickness="1" 
                            Background="#F0F0F0"
                            AllowDrop="True"
                            Drop="TargetCell_Drop"
                            DragOver="TargetCell_DragOver"/>
                    <Border x:Name="targetCell2" Grid.Row="1" Grid.Column="0" 
                            BorderBrush="Gray" BorderThickness="1" 
                            Background="#F0F0F0"
                            AllowDrop="True"
                            Drop="TargetCell_Drop"
                            DragOver="TargetCell_DragOver"/>
                    <Border x:Name="targetCell3" Grid.Row="1" Grid.Column="1" 
                            BorderBrush="Gray" BorderThickness="1" 
                            Background="#F0F0F0"
                            AllowDrop="True"
                            Drop="TargetCell_Drop"
                            DragOver="TargetCell_DragOver"/>
                </Grid>
            </Border>

            <!-- Панель с кусочками пазла -->
            <TextBlock Text="Перетащите кусочки в правильном порядке:"
                       FontSize="14"
                       FontFamily="Comic Sans"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"
                       Foreground="#555555"/>

            <WrapPanel x:Name="puzzlePiecesPanel" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20">
            </WrapPanel>

            <Button x:Name="verifyButton"
                    Content="ПРОВЕРИТЬ КАПЧУ"
                    FontSize="20"
                    Width="250"
                    Height="50"
                    FontFamily="Comic Sans MS"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,0,15"
                    Click="VerifyButton_Click"/>

            <TextBlock x:Name="attemptsText"
                       Text="Осталось попыток: 3"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="Red"/>
        </StackPanel>
    </Grid>
</Window>
