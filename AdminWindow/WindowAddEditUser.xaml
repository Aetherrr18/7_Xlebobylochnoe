<Window x:Class="_7_Xlebobylochnoe.AdminWindow.WindowAddEditUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_7_Xlebobylochnoe.AdminWindow"
        mc:Ignorable="d"
        Title="Добавление/редактирование"
        Height="450" Width="500"
        MinHeight="450" MinWidth="500"
        FontFamily="Comic Sans">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="lblTitle" 
                       Text="Добавление/редактирование пользователя" 
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Width="400"
                       FontSize="20"
                       FontFamily="Comic Sans MS" 
                       FontWeight="Bold"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30"/>

            <!-- Логин -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Логин:" 
                           FontSize="15" 
                           Margin="0,0,0,5"/>
                <TextBox x:Name="tbLogin" 
                         Height="30" 
                         FontSize="15"
                         BorderThickness="1"/>
            </StackPanel>

            <!-- Пароль -->
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Пароль:" 
                           FontSize="15" 
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="pbPassword" 
                             Height="30" 
                             FontSize="15"
                             BorderBrush="Gray" 
                             BorderThickness="1"/>
            </StackPanel>

            <!-- Роль -->
            <StackPanel Margin="0,0,0,25">
                <TextBlock Text="Роль:" 
                           FontSize="15" 
                           Margin="0,0,0,5"/>
                <ComboBox x:Name="cbRole" 
                          Height="30" 
                          FontSize="15"
                          DisplayMemberPath="role_name"
                          SelectedValuePath="role_id"/>
            </StackPanel>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Сохранить" 
                        Width="120" Height="35" 
                        FontSize="15"
                        Margin="0,0,10,0"
                        Click="BtnSave_Click"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"/>

                <Button Content="Отмена" 
                        Width="120" Height="35" 
                        FontSize="15"
                        Click="BtnCancel_Click"
                        Background="#f44336"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Grid>

</Window>
