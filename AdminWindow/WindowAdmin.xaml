<Window x:Class="_7_Xlebobylochnoe.AdminWindow.WindowAdmin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_7_Xlebobylochnoe.AdminWindow"
        mc:Ignorable="d"
        Title="Рабочий стол Администратора"
        Height="850" Width="1000"
        MinHeight="850" MinWidth="1000">
    <Grid Background="White">
        <StackPanel Margin="20">
            <!-- Заголовок -->
            <TextBlock Text="Рабочий стол Администратора" 
                       FontFamily="Comic Sans MS" 
                       HorizontalAlignment="Center" 
                       TextAlignment="Center"
                       FontSize="40" 
                       Margin="0,0,0,20"
                       Height="70"
                       Width="1000"
                       Background="BurlyWood"/>

            <!-- Таблица пользователей -->
            <DataGrid x:Name="dgUsers" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single" 
                      Height="400"
                      Margin="0,0,0,20"
                      FontFamily="Comic Sans MS"
                      Background="White"
                      BorderBrush="Gray"
                      FontSize="20">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Логин" 
                                        Binding="{Binding login}" 
                                        Width="*"/>
                    <DataGridTextColumn Header="Роль" 
                                        Binding="{Binding role.role_name}" 
                                        Width="*"/>
                    <DataGridTextColumn Header="Заблокирован" 
                                        Binding="{Binding is_blocked}" 
                                        Width="*"/>
                    <DataGridTextColumn Header="Неудачных попыток" 
                                        Binding="{Binding failed_attempts}" 
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Поля ввода -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,0,0,10">
                <StackPanel Margin="5">
                    <TextBlock Text="Логин" 
                               FontFamily="Comic Sans MS"
                               FontSize="25"/>
                    <TextBox x:Name="tbLogin" 
                             Width="250" 
                             Height="40" 
                             FontSize="25"
                             FontFamily="Comic Sans MS"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="Пароль" 
                               FontFamily="Comic Sans MS"
                               FontSize="25"/>
                    <PasswordBox x:Name="pbPassword" 
                                 Width="250" 
                                 Height="40" 
                                 FontSize="25"
                                 FontFamily="Comic Sans MS"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="Роль" 
                               FontFamily="Comic Sans MS"
                               FontSize="25"/>
                    <ComboBox x:Name="cbRole"
                              DisplayMemberPath="role_name"
                              SelectedValuePath="role_id"
                              Width="250" 
                              Height="40"
                              FontSize="25"
                              FontFamily="Comic Sans MS"/>
                </StackPanel>
            </StackPanel>

            <!-- Кнопки действий -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center">
                <Button Content="Добавить пользователя" 
                        Width="300" 
                        Height="45" 
                        FontFamily="Comic Sans MS" 
                        FontSize="25"
                        Margin="10" 
                        Click="BtnAdd_Click"/>

                <Button Content="Изменить данные" 
                        Width="250" 
                        Height="45" 
                        FontFamily="Comic Sans MS" 
                        FontSize="25" 
                        Margin="10" 
                        Click="BtnEdit_Click"/>

                <Button Content="Снять блокировку" 
                        Width="250"
                        Height="45" 
                        FontFamily="Comic Sans MS" 
                        FontSize="25" 
                        Margin="10" 
                        Click="BtnUnblock_Click"/>
            </StackPanel>

            <!-- Кнопка выхода -->
            <Button Content="Выйти" 
                    Width="300" 
                    Height="55" 
                    FontSize="35"
                    FontFamily="Comic Sans MS" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,0" 
                    Background="BurlyWood"
                    Click="BtnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>
